# ==========================================
# BrandPulse AI - Frontend Environment Configuration
# ==========================================

# Backend API Base URL
# - Development (Vite dev server against local backend): http://127.0.0.1:8000/api/v1
# - Docker (Reverse proxied by Nginx): /api/v1
# - Production (Standalone hosting): https://api.yourdomain.com/api/v1
VITE_API_URL=http://127.0.0.1:8000/api/v1

# Firebase Authentication (Optional - configure if using Google / Firebase OAuth)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
