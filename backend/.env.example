# ==========================================
# BrandPulse AI - Backend Environment Configuration
# ==========================================

# Application Settings
PROJECT_NAME="Advanced Brandpulse AI"
VERSION="1.0.0"
PORT=8000

# Security & JWT (MANDATORY: Minimum 32 characters, no default fallback allowed)
SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-chars-long"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS & Frontend Origins (Comma-separated exact origins without wildcards)
# Examples: http://localhost:5173,http://localhost:80,https://app.yourdomain.com
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://localhost"
FRONTEND_URL="http://localhost:5173"

# Database Configuration (MongoDB Atlas or Local MongoDB)
# Local: mongodb://localhost:27017 or mongodb://mongo:27017 (in Docker)
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/brandpulse_ai?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017"
DATABASE_NAME="brandpulse_ai"

# Demo Mode & Seeding
# When false: stops inserting fake seed history on brand creation and disables fake stream ingestion
# When true: enables synthetic history seeding and simulated demo streaming
DEMO_MODE=false

# Rate Limiting & Distributed Cache
# Leave empty for in-memory rate limiting, or set redis:// URI for multi-instance deployments
REDIS_URL="redis://localhost:6379/0"

# AI & Multilingual Analysis Configuration
# ANALYSIS_BACKEND options: "local" (fast Scikit-learn + VADER), "hybrid" (local + LLM fallback), "llm" (direct LLM prompt)
ANALYSIS_BACKEND="local"
# LLM_PROVIDER options: "local", "groq", "gemini", "openai", "claude", "ollama"
LLM_PROVIDER="local"
LLM_API_KEY=""
# LLM Model choices: "llama-3.3-70b-versatile" (Groq), "gemini-1.5-flash" (Google), "gpt-4o-mini" (OpenAI), "claude-3-5-haiku-20241022" (Anthropic)
LLM_MODEL=""
MULTILINGUAL_MODEL_NAME="xlm-roberta-base"

# Google Places / Business Profile API
# Leave blank or set GOOGLE_BUSINESS_MOCK_MODE=true for simulated Google Reviews
GOOGLE_PLACES_API_KEY=""
GOOGLE_BUSINESS_MOCK_MODE=true

# Meta / Instagram Graph API Configuration
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI="http://localhost:5173/brand-settings"
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_GRAPH_VERSION="v19.0"
INSTAGRAM_MOCK_MODE=true

# Facebook Page Graph API
FACEBOOK_PAGE_ID=""
FACEBOOK_ACCESS_TOKEN=""
FACEBOOK_MOCK_MODE=true

# Notification Channels (Email & WhatsApp / SMS)
# Resend or SMTP for Email Alerts
RESEND_API_KEY=""
NOTIFICATION_FROM_EMAIL="alerts@brandpulse.local"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# Twilio for WhatsApp and SMS Alerts
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
TWILIO_SMS_FROM=""
NOTIFICATION_MOCK_MODE=true

# Storage Abstraction (local or s3)
# Set to 'local' for local filesystem (/app/storage) or 's3' for AWS S3 / MinIO / LocalStack
STORAGE_BACKEND="local"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""
AWS_ENDPOINT_URL=""

# Plan Limits & Quotas (Free vs Pro tiers)
PLAN_FREE_MAX_BUSINESSES=1
PLAN_FREE_MAX_REVIEWS_PER_MONTH=100
PLAN_FREE_MAX_AI_CHAT_PER_MONTH=20
PLAN_PRO_MAX_BUSINESSES=10
PLAN_PRO_MAX_REVIEWS_PER_MONTH=5000
PLAN_PRO_MAX_AI_CHAT_PER_MONTH=500

# Trusted Proxies for Client IP Resolution (X-Forwarded-For)
TRUSTED_PROXIES="127.0.0.1,::1,frontend"

# Firebase Authentication (Optional backend integration)
FIREBASE_PROJECT_ID=""
