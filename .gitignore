# ====================================================================
# BrandPulse AI - Git Ignore Configuration
# ====================================================================

# --------------------------------------------------------------------
# 1. Environment & Sensitive Credentials (CRITICAL - DO NOT COMMIT)
# --------------------------------------------------------------------
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!*.env.example
!.env.*.example
*.pem
*.key
*.p12
*serviceAccountKey*.json
*firebase-adminsdk*.json
*credentials*.json
*client_secret*.json

# --------------------------------------------------------------------
# 2. Node / React Frontend
# --------------------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
.eslintcache
*.tsbuildinfo
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --------------------------------------------------------------------
# 3. Python Backend & ML
# --------------------------------------------------------------------
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# --------------------------------------------------------------------
# 4. Virtual Environments
# --------------------------------------------------------------------
env/
venv/
ENV/
.venv/
env.bak/
venv.bak/
backend/env/
backend/venv/
backend/.venv/

# --------------------------------------------------------------------
# 5. Generated Runtime Data & Exported Reports
# --------------------------------------------------------------------
backend/storage/reports/*
!backend/storage/reports/.gitkeep
backend/storage/data/local_db.json
backend/storage/data/*.csv
!backend/storage/data/.gitkeep
storage/reports/*
storage/data/*
*.log
backend/app/models/*_v*.joblib

